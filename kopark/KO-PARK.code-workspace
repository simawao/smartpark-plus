      "**/dist": true,
      "**/node_modules": true
    },
    "typescript.tsdk": "node_modules/typescript/lib"
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "bmewburn.vscode-intelephense-client",
      "mtxr.sqltools",
      "mtxr.sqltools-driver-mysql"
    ]
  }
